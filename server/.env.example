# העתיקו את הקובץ הזה ל-server/.env ומלאו את הערכים האמיתיים שם.
# server/.env לא נכנס ל-git ואסור להעלות אותו לשום מקום — הוא רק על המחשב שלכם.
#
# בלי אף אחד מהערכים האלה האפליקציה עדיין רצה מקומית: המסד יהיה PGlite
# מקומי, הסרטונים יישמרו לדיסק, וה-AI יהיה כבוי.

# --- המסד (Neon) ---
# מהדשבורד של neon.com, כפתור Connect. מתחיל ב-postgresql://
# בלי זה: מסד מקומי ב-server/pgdata/
DATABASE_URL=

# --- הסרטונים (Cloudinary) ---
# מהדשבורד של cloudinary.com, אזור Product Environment Credentials.
# בלי אלה: הסרטונים נשמרים ל-server/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- לוח הבקרה (/admin.html) ---
# סיסמה אחת למחיקת משתמשים וסרטונים. בלי זה, /admin.html מציג הודעה
# שהלוח לא הוגדר — אין ברירת מחדל, בכוונה.
ADMIN_PASSWORD=

# --- ההרשמה ---
# כשמוגדר, אי אפשר להירשם בלי להקליד את הקוד הזה. ריק = הרשמה פתוחה.
INVITE_CODE=

# --- הגבלות קצב (אופציונלי) ---
# כמה הרשמות לשעה מאותה כתובת IP. ברירת מחדל 20.
# קבוצה מאותו wifi נראית ככתובת אחת, אז אל תוריד את זה נמוך מדי.
# REGISTER_LIMIT_HOUR=20
# כמה נסיונות התחברות לרבע שעה מאותה כתובת. ברירת מחדל 30.
# LOGIN_LIMIT_QUARTER=30

# --- ה-AI ---
# בלי המפתח האפליקציה עובדת רגיל, ובמקום העוזר מוצגת הודעה.
ANTHROPIC_API_KEY=

# אופציונלי — ברירת המחדל היא claude-sonnet-5
# SKATELAB_AI_MODEL=claude-sonnet-5

# אופציונלי — מכסות ה-AI לכל משתמש
# AI_LIMIT_HOUR=20
# AI_LIMIT_DAY=100
